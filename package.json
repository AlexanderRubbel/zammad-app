{
  "name": "zammad-app",
  "version": "0.3.0",
  "description": "Zammad Desktop - eigenes Fenster mit nativen Benachrichtigungen (Windows & Linux)",
  "main": "main.js",
  "author": "Zammad Desktop",
  "license": "MIT",
  "scripts": {
    "icons": "node make-icon.js",
    "start": "npm run icons && electron .",
    "dist": "node build.js",
    "dist:linux": "node build-linux.js"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.zammad.app",
    "productName": "Zammad Desktop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "settings.html",
      "build/icon.png",
      "build/tray.png",
      "build/badge.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": ["pacman", "AppImage"],
      "artifactName": "${name}.${ext}",
      "icon": "build/icon.png",
      "executableName": "zammad-desktop",
      "category": "Office",
      "maintainer": "AlexanderRubbel <128258510+AlexanderRubbel@users.noreply.github.com>",
      "synopsis": "Zammad im eigenen Fenster mit nativen Benachrichtigungen",
      "description": "Eigenständiger Client für die Zammad-Weboberfläche mit nativen Desktop-Benachrichtigungen, Tray und Autostart."
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
